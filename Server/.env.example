PORT=8000

# Your Env Below
# Connect to Supabase via connection pooling with Supavisor.
DATABASE_URL="postgresql://user:password@localhost:5432/postgres?pgbouncer=true"

# Direct connection to the database. Used for migrations.
DIRECT_URL="postgresql://user:password@localhost:5432/postgres"
        
JWT_SECRET="your_jwt_secret_key_here"
JWT_EXPIRES_IN = "1d"


MIDTRANS_CLIENT_KEY = "SB-Mid-client-your-client-key"
MIDTRANS_SERVER_KEY = "SB-Mid-server-your-server-key"